# Salin file ini ke .env dan isi nilainya
# JANGAN commit file .env ke Git!

# Token bot Slack — dari halaman OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Token app Socket Mode — dari halaman Socket Mode
SLACK_APP_TOKEN=xapp-your-app-token-here

# Signing secret — dari halaman Basic Information (opsional untuk Socket Mode)
SLACK_SIGNING_SECRET=your-signing-secret-here

# Groq API — untuk AI Brain di tahap berikutnya (daftar gratis di groq.com)
GROQ_API_KEY=gsk_your-groq-key-here
